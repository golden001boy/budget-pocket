{
  "name": "budget-pocket",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "turbo run format",
    "db:migrate": "pnpm --filter web run db:migrate",
    "db:generate": "pnpm --filter web run db:generate",
    "db:seed": "pnpm --filter web run db:seed",
    "db:studio": "pnpm --filter web run db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "mobile>@types/react": "18.3.1",
      "mobile>@types/react-dom": "18.3.1",
      "send": "^0.19.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "tar": "^7.5.19",
      "postcss": "^8.5.23",
      "@xmldom/xmldom": "^0.8.15",
      "fast-xml-parser": "^5.7.0",
      "uuid@<11.1.1": ">=11.1.1",
      "turbo-stream": "^3.0.0",
      "js-yaml": "^4.3.2",
      "artillery>js-yaml": "^3.15.2",
      "brace-expansion": "^5.0.9",
      "fast-uri": "^3.1.6",
      "sharp": "^0.35.4",
      "next-auth": "^4.24.15",
      "@auth/core": "^0.41.3",
      "@opentelemetry/core": "^2.8.0",
      "nanoid": "^3.3.18",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "joi": "^17.13.6",
      "qs": "^6.16.0",
      "csv-parse": "^7.0.2",
      "@faker-js/faker": "^10.5.0",
      "@remix-run/node>undici": "^6.28.0",
      "cheerio>undici": "^7.29.0",
      "query-string>decode-uri-component": "^0.5.0",
      "fflate": "^0.8.3"
    },
    "packageExtensions": {
      "@react-navigation/bottom-tabs": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@react-navigation/core": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@react-navigation/native": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@react-navigation/native-stack": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@react-navigation/elements": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "expo-router": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    },
    "neverBuiltDependencies": ["react-native-screens"]
  }
}
