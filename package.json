{
  "name": "budget-pocket",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "turbo run format",
    "db:migrate": "pnpm --filter web run db:migrate",
    "db:generate": "pnpm --filter web run db:generate",
    "db:seed": "pnpm --filter web run db:seed",
    "db:studio": "pnpm --filter web run db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.1",
      "@types/react-dom": "18.3.1",
      "send": "^0.19.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "tar": "^7.5.19",
      "postcss": "^8.5.10",
      "@xmldom/xmldom": "^0.8.13",
      "fast-xml-parser": "^5.7.0",
      "uuid@<11.1.1": ">=11.1.1",
      "turbo-stream": "^3.0.0",
      "js-yaml": "^4.3.0",
      "brace-expansion": "^5.0.7",
      "fast-uri": "^3.1.4"
    },
    "packageExtensions": {
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "18.3.1"
        }
      }
    },
    "neverBuiltDependencies": ["react-native-screens"]
  }
}
