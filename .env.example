# Database
DATABASE_URL="postgresql://user:password@localhost:5432/budget_pocket"
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# Resend
RESEND_API_KEY=""
RESEND_FROM="Budget-Pocket <noreply@budget-pocket.ci>"

# Sentry
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Budget-Pocket"

# External APIs
COINGECKO_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# AI Advisor
ANTHROPIC_API_KEY=""

# Cron protection
CRON_SECRET="generate-random-string"

# Feature flags
NEXT_PUBLIC_ENABLE_AI_ADVISOR="true"
NEXT_PUBLIC_ENABLE_SYNC="false"
