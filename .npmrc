strict-peer-dependencies=false
# resolve-peers-from-workspace-root=true (baseline scaffolding, since the
# initial commit) removed in story 15.10: it makes pnpm consider every
# workspace project's dependencies as valid peer providers for every other
# project, so apps/web's @radix-ui/* packages (peer "@types/react": "*")
# were nondeterministically resolving against apps/mobile's @types/react
# (18.3.1) instead of web's own (19.2.17) — see ADR-009.
#
# Equivalent to shamefully-hoist=true (public-hoist-pattern[]=*) but spelled
# out explicitly so the negations below actually apply — shamefully-hoist as
# a separate boolean does not reliably compose with public-hoist-pattern
# negation entries (pnpm#7312).
#
# apps/web (React 19) and apps/mobile (React 18, Expo) need different major
# versions of @types/react side by side (story 15.10). Hoisting picks one to
# flatten to the workspace root, which then leaks into deeply nested
# packages' own type resolution (e.g. @radix-ui/*) via directory walk-up,
# regardless of their own correctly peer-resolved local symlink. Excluding
# these two forces strict per-instance resolution instead.
public-hoist-pattern[]=*
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
# public-hoist-pattern only controls the top-level root node_modules.
# Nested packages' own directory walk-up resolution hits a *second*, hidden
# hoist layer first (node_modules/.pnpm/node_modules/), governed separately
# by hoist-pattern — needs the same exclusion or it leaks 18.3.1 right back.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
