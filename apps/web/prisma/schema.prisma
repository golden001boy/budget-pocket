generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════

enum Role {
  FREE
  PREMIUM
  ADMIN
}

enum Currency {
  XOF
  EUR
  USD
  GBP
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  HOUSING
  UTILITIES
  HEALTH
  EDUCATION
  ENTERTAINMENT
  CLOTHING
  SAVINGS
  INVESTMENT
  INSURANCE
  TAXES
  GIFTS
  SUBSCRIPTIONS
  OTHER
}

enum ExpenseType {
  FIXED
  CURRENT
  OCCASIONAL
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum SyncProvider {
  WAVE
  MTN_MONEY
  ORANGE_MONEY
  MANUAL
}

enum SyncStatus {
  ACTIVE
  PAUSED
  ERROR
  PENDING
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum GoalType {
  SAVINGS
  DEBT_PAYOFF
  PURCHASE
  EMERGENCY_FUND
  RETIREMENT
  EDUCATION
  TRAVEL
  OTHER
}

enum AssetClass {
  STOCK_BRVM
  STOCK_INTL
  CRYPTO
  REAL_ESTATE
  BOND
  SAVINGS_ACCOUNT
  OTHER
}

enum AlertType {
  OVERSPEND
  LOW_BALANCE
  GOAL_MILESTONE
  SYNC_ERROR
  AI_RECOMMENDATION
  PRICE_ALERT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ScenarioType {
  REAL_ESTATE
  EARLY_RETIREMENT
  STOCK_INVESTMENT
  BUSINESS_CREATION
  EDUCATION_FUND
  CUSTOM
}

// ═══════════════════════════════════════════════════
// MODEL 1 — User
// ═══════════════════════════════════════════════════

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  phone          String?
  avatarUrl      String?
  role           Role     @default(FREE)
  currency       Currency @default(XOF)
  timezone       String   @default("Africa/Abidjan")
  onboardingDone Boolean  @default(false)
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Story 15.32 (ADR-008 residual, MFA): mfaSecret is the TOTP secret
  // encrypted at rest (AES-256-GCM, lib/mfaCrypto.ts) — unlike passwordHash
  // it can't be a one-way hash, since verifying a code requires recomputing
  // the HMAC from the raw secret. mfaEnabled stays false while a secret has
  // been generated but not yet confirmed with a valid code (lib/mfa.ts).
  // mfaRecoveryCodes are bcrypt-hashed, one-time, consumed on use.
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[] @default([])

  sessions         Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  subscriptions    Subscription[]
  accounts         LinkedAccount[]
  transactions     Transaction[]
  budgets          Budget[]
  categories       CustomCategory[]
  goals            FinancialGoal[]
  portfolioItems   PortfolioItem[]
  alerts           Alert[]
  aiConversations  AIConversation[]
  scenarios        Scenario[]
  taxRecords       TaxRecord[]
  retirementPlan   RetirementPlan?
  monthlySnapshots MonthlySnapshot[]
}

// ═══════════════════════════════════════════════════
// MODEL 2 — Session + Subscription
// ═══════════════════════════════════════════════════

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  stripeId  String?   @unique
  status    String
  plan      String    @default("free")
  startedAt DateTime
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════
// MODEL 3 — LinkedAccount
// ═══════════════════════════════════════════════════

model LinkedAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       SyncProvider
  accountName    String
  accountNumber  String?
  currency       Currency     @default(XOF)
  balance        Decimal      @default(0) @db.Decimal(18, 2)
  balanceAt      DateTime?
  syncStatus     SyncStatus   @default(PENDING)
  syncError      String?
  lastSyncAt     DateTime?
  externalId     String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, provider, accountNumber])
  @@index([userId, syncStatus])
}

// ═══════════════════════════════════════════════════
// MODEL 4 — Transaction
// ═══════════════════════════════════════════════════

model Transaction {
  id               String          @id @default(cuid())
  userId           String
  accountId        String?
  category         ExpenseCategory
  customCategoryId String?
  type             TransactionType
  expenseType      ExpenseType?
  amount           Decimal         @db.Decimal(18, 2)
  currency         Currency        @default(XOF)
  description      String?
  merchant         String?
  date             DateTime
  isRecurring      Boolean         @default(false)
  recurringId      String?
  budgetId         String?
  tags             String[]
  receiptUrl       String?
  notes            String?
  source           SyncProvider    @default(MANUAL)
  externalId       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        LinkedAccount?    @relation(fields: [accountId], references: [id])
  customCategory CustomCategory?   @relation(fields: [customCategoryId], references: [id])
  budget         Budget?           @relation(fields: [budgetId], references: [id])
  recurringRule  RecurringRule?    @relation(fields: [recurringId], references: [id])

  @@unique([userId, externalId, source])
  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, type, date])
}

// ═══════════════════════════════════════════════════
// MODEL 5 — Budget
// ═══════════════════════════════════════════════════

model Budget {
  id               String          @id @default(cuid())
  userId           String
  category         ExpenseCategory
  customCategoryId String?
  amount           Decimal         @db.Decimal(18, 2)
  currency         Currency        @default(XOF)
  month            Int
  year             Int
  spent            Decimal         @default(0) @db.Decimal(18, 2)
  alertAt          Decimal?        @db.Decimal(5, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, category, month, year])
  @@index([userId, year, month])
}

// ═══════════════════════════════════════════════════
// MODEL 6 — CustomCategory
// ═══════════════════════════════════════════════════

model CustomCategory {
  id             String           @id @default(cuid())
  userId         String
  name           String
  icon           String?
  color          String?
  parentCategory ExpenseCategory?
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

// ═══════════════════════════════════════════════════
// MODEL 7 — RecurringRule
// ═══════════════════════════════════════════════════

model RecurringRule {
  id         String          @id @default(cuid())
  userId     String
  name       String
  amount     Decimal         @db.Decimal(18, 2)
  currency   Currency        @default(XOF)
  category   ExpenseCategory
  dayOfMonth Int
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean         @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime        @default(now())

  transactions Transaction[]

  @@index([isActive, nextRunAt])
}

// ═══════════════════════════════════════════════════
// MODEL 8 — FinancialGoal
// ═══════════════════════════════════════════════════

model FinancialGoal {
  id            String     @id @default(cuid())
  userId        String
  name          String
  type          GoalType
  targetAmount  Decimal    @db.Decimal(18, 2)
  currentAmount Decimal    @default(0) @db.Decimal(18, 2)
  currency      Currency   @default(XOF)
  deadline      DateTime?
  status        GoalStatus @default(ACTIVE)
  priority      Int        @default(1)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ═══════════════════════════════════════════════════
// MODEL 9 — PortfolioItem
// ═══════════════════════════════════════════════════

model PortfolioItem {
  id             String     @id @default(cuid())
  userId         String
  assetClass     AssetClass
  ticker         String
  name           String
  exchange       String?
  quantity       Decimal    @db.Decimal(18, 8)
  averageCost    Decimal    @db.Decimal(18, 6)
  currency       Currency   @default(XOF)
  purchaseDate   DateTime
  notes          String?
  currentPrice   Decimal?   @db.Decimal(18, 6)
  priceUpdatedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceHistory AssetPriceSnapshot[]

  @@index([userId, assetClass])
  @@index([ticker])
}

// ═══════════════════════════════════════════════════
// MODEL 10 — AssetPriceSnapshot
// ═══════════════════════════════════════════════════

model AssetPriceSnapshot {
  id              String    @id @default(cuid())
  portfolioItemId String
  ticker          String
  price           Decimal   @db.Decimal(18, 6)
  currency        Currency
  source          String
  recordedAt      DateTime

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, recordedAt])
  @@index([ticker, recordedAt])
}

// ═══════════════════════════════════════════════════
// MODEL 11 — Alert
// ═══════════════════════════════════════════════════

model Alert {
  id          String        @id @default(cuid())
  userId      String
  type        AlertType
  severity    AlertSeverity @default(INFO)
  title       String
  body        String
  actionUrl   String?
  isRead      Boolean       @default(false)
  isDismissed Boolean       @default(false)
  metadata    Json?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ═══════════════════════════════════════════════════
// MODEL 12 — AIConversation + AIMessage
// ═══════════════════════════════════════════════════

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, createdAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  tokensUsed     Int?
  modelId        String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════════════
// MODEL 13 — Scenario
// ═══════════════════════════════════════════════════

model Scenario {
  id          String       @id @default(cuid())
  userId      String
  type        ScenarioType
  name        String
  description String?
  inputs      Json
  results     Json?
  computedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ═══════════════════════════════════════════════════
// MODEL 14 — MonthlySnapshot
// ═══════════════════════════════════════════════════

model MonthlySnapshot {
  id                String   @id @default(cuid())
  userId            String
  year              Int
  month             Int
  totalIncome       Decimal  @db.Decimal(18, 2)
  totalExpenses     Decimal  @db.Decimal(18, 2)
  totalSavings      Decimal  @db.Decimal(18, 2)
  savingsRate       Decimal  @db.Decimal(5, 2)
  netWorth          Decimal? @db.Decimal(18, 2)
  categoryBreakdown Json
  computedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year])
}

// ═══════════════════════════════════════════════════
// MODEL 15 — RetirementPlan
// ═══════════════════════════════════════════════════

model RetirementPlan {
  id                  String   @id @default(cuid())
  userId              String   @unique
  currentAge          Int
  targetRetirementAge Int      @default(65)
  currentSavings      Decimal  @db.Decimal(18, 2)
  monthlyContribution Decimal  @db.Decimal(18, 2)
  expectedReturnRate  Decimal  @db.Decimal(5, 2)
  inflationRate       Decimal  @default(3.00) @db.Decimal(5, 2)
  targetMonthlyIncome Decimal  @db.Decimal(18, 2)
  notes               String?
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════
// MODEL 16 — TaxRecord
// ═══════════════════════════════════════════════════

model TaxRecord {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  category  String
  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(XOF)
  dueDate   DateTime?
  paidAt    DateTime?
  isPaid    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
}

// ═══════════════════════════════════════════════════
// MODEL 17 — NewsletterSubscriber
// ═══════════════════════════════════════════════════

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique @default(cuid())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([email])
}
