# ─────────────────────────────────────────────────────────────────────────────
# Budget-Pocket — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL ─────────────────────────────────────────────
# Dev local  : postgresql://postgres:password@localhost:5432/budget_pocket
# Production : Neon (https://neon.tech) — gratuit jusqu'à 0.5 GB
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/budget_pocket?sslmode=require"

# ── Redis ──────────────────────────────────────────────────────────────────
# Dev local  : redis://localhost:6379
# Production : Upstash (https://upstash.com) — gratuit jusqu'à 10 000 req/jour
REDIS_URL="redis://localhost:6379"

# ── NextAuth ───────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_32_CHARS_MINIMUM"
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ─────────────────────────────────────────────────────────────────
# Clés disponibles sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs de prix créés dans le dashboard Stripe
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# ── IA (désactivé — décommenter pour activer) ──────────────────────────────
# Anthropic : https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."
# Groq (alternative gratuite) : https://console.groq.com
# GROQ_API_KEY="gsk_..."

# ── Prix marché ────────────────────────────────────────────────────────────
# CoinGecko — optionnel, augmente le rate limit (gratuit sans clé)
# COINGECKO_API_KEY=""
# Alpha Vantage — marchés internationaux (gratuit 25 req/jour)
# ALPHA_VANTAGE_API_KEY=""

# ── Email (optionnel, mais utilisé depuis la story 15.11) ──────────────────
# Resend : https://resend.com — 100 emails/jour gratuits
# Sans clé : lib/email.ts logue le lien de réinitialisation dans la console
# serveur au lieu de l'envoyer (comme Sentry sans DSN — no-op, pas d'erreur).
# RESEND_API_KEY="re_..."
# RESEND_FROM="Budget-Pocket <no-reply@budget-pocket.app>"

# ── Crons (sécurité) ───────────────────────────────────────────────────────
# Secret partagé pour authentifier les appels cron
# Générer avec : openssl rand -hex 32
CRON_SECRET="CHANGE_ME_RANDOM_HEX"

# ── Monitoring (optionnel) ─────────────────────────────────────────────────
# Sentry : https://sentry.io — DSN vide = SDK initialisé mais inactif (no-op)
# NEXT_PUBLIC_SENTRY_DSN=""
# Pour l'upload des source maps au build (optionnel, sinon juste ignoré) :
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# ── Feature flags ──────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI_ADVISOR="false"
NEXT_PUBLIC_ENABLE_SYNC="false"
